<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
       Precompiled libpng for FreeSWITCH. Replaces the in-tree build
       (libs\win32\libpng\libpng.2017.vcxproj + w32\download_libpng.props): import
       this from the projects that referenced that project (FreeSwitchCore, mod_png)
       instead of the ProjectReference, and remove the libpng project from the
       solution.
  -->
  <PropertyGroup>
    <libpngImported>true</libpngImported>
  </PropertyGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="libpng-version.props" Condition=" '$(libpngVersionImported)' == '' "/>
    <Import Project="downloadpackage.task" Condition=" '$(downloadpackagetask_Imported)' == '' " />
    <!-- libpng16.dll loads zlib.dll (zlibd.dll in Debug) at run time; zlib.props
         downloads the matching zlib package and copies that DLL to the output dir. -->
    <Import Project="zlib.props" Condition=" '$(zlibImported)' == '' "/>
  </ImportGroup>

  <!-- The packages ship only Release and Debug; map any project configuration
       (e.g. "Release All") onto one of them. Debug binaries carry the "d" postfix. -->
  <PropertyGroup>
    <LibraryConfiguration Condition="$(Configuration.ToLower().Contains('debug'))">Debug</LibraryConfiguration>
    <LibraryConfiguration Condition="$(Configuration.ToLower().Contains('release'))">Release</LibraryConfiguration>
    <libpngLibraryFileName Condition=" '$(LibraryConfiguration)' == 'Debug' ">libpng16d</libpngLibraryFileName>
    <libpngLibraryFileName Condition=" '$(LibraryConfiguration)' == 'Release' ">libpng16</libpngLibraryFileName>
  </PropertyGroup>

  <PropertyGroup Label="UserMacros">
    <!-- Package name = zip prefix = folder inside the zips (the build number is part
         of it so a rebuilt package lands in a new folder and gets picked up). -->
    <libpngPkg>libpng-$(libpngVersion)_$(libpngBuildNumber)</libpngPkg>
    <libpngLibDir>$(BaseDir)libs\$(libpngPkg)</libpngLibDir>
    <libpngBinDir>$(libpngLibDir)\binaries\$(Platform)\$(LibraryConfiguration)</libpngBinDir>
    <!-- GitHub Release assets of freeswitch/windows-deps (tag libpng-v<version>_<build>). -->
    <libpngPkgBase>https://github.com/freeswitch/windows-deps/releases/download/libpng-v$(libpngVersion)_$(libpngBuildNumber)</libpngPkgBase>
  </PropertyGroup>

  <!-- Download + extract the per-platform, per-configuration binaries (DLL + import lib + static lib). -->
  <Target Name="libpngBinariesDownloadTarget" BeforeTargets="CustomBuild" DependsOnTargets="7za">
      <DownloadPackageTask
           package="$(libpngPkgBase)/$(libpngPkg)-binaries-$(Platform.ToLower())-$(LibraryConfiguration.ToLower()).zip"
           expectfileordirectory="$(libpngBinDir)\lib\$(libpngLibraryFileName).lib"
           outputfolder=""
           outputfilename=""
           extractto="$(BaseDir)libs\"
      />
  </Target>

  <!-- Download + extract the public headers (platform/configuration independent). -->
  <Target Name="libpngHeadersDownloadTarget" BeforeTargets="CustomBuild" DependsOnTargets="7za">
      <DownloadPackageTask
           package="$(libpngPkgBase)/$(libpngPkg)-headers.zip"
           expectfileordirectory="$(libpngLibDir)\include\png.h"
           outputfolder=""
           outputfilename=""
           extractto="$(BaseDir)libs\"
      />
  </Target>

  <!-- Copy libpng16.dll / libpng16d.dll next to the FreeSWITCH binary. -->
  <Target Name="libpngCopyTarget" BeforeTargets="CustomBuild" DependsOnTargets="libpngBinariesDownloadTarget">
      <ItemGroup>
          <libpngFiles Include="$(libpngBinDir)\bin\*.dll" />
      </ItemGroup>
      <Copy SkipUnchangedFiles="true"
          SourceFiles="@(libpngFiles)"
          DestinationFiles="@(libpngFiles->'$(BaseDir)$(Platform)\$(LibraryConfiguration)\%(Filename)%(Extension)')"
      />
  </Target>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- png.h, pngconf.h, pnglibconf.h -->
      <AdditionalIncludeDirectories>$(libpngLibDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- libpng16.lib / libpng16d.lib is the import library for libpng16.dll /
           libpng16d.dll. For a static link use libpng16_static.lib /
           libpng16_staticd.lib instead and link zlib as well. -->
      <AdditionalLibraryDirectories>$(libpngBinDir)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(libpngLibraryFileName).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>

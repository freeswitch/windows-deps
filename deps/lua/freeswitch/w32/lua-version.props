<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <!-- Release tag in freeswitch/windows-deps: lua-v$(LuaVersion)_$(LuaBuildNumber) -->
    <LuaVersion>5.3.6</LuaVersion>
    <LuaBuildNumber>1</LuaBuildNumber>
  </PropertyGroup>
  <PropertyGroup>
    <LuaVersionImported>true</LuaVersionImported>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup />
  <ItemGroup>
    <BuildMacro Include="LuaVersion">
      <Value>$(LuaVersion)</Value>
    </BuildMacro>
    <BuildMacro Include="LuaBuildNumber">
      <Value>$(LuaBuildNumber)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>

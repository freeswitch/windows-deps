<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets">
    <Import Project="libpcap-version.props" Condition=" '$(libpcapVersionImported)' == '' "/>
    <Import Project="downloadpackage.task" Condition=" '$(downloadpackagetask_Imported)' == '' " />
  </ImportGroup>

  <PropertyGroup Label="UserMacros">
    <libpcap_libDir>$(BaseDir)libs\libpcap-$(libpcapVersion)_$(libpcapBuildNumber)</libpcap_libDir>
  </PropertyGroup>

  <!-- 
       Download Target.
       Name must be unique. 
       By design, targets are executed only once per project.
       
       Usage:
       
       package: URI

       expectfileordirectory: Skips the download and extraction if exists

       outputfolder: Folder to store a downloaded file. 
                     By default "$(BaseDir)libs", if empty

       outputfilename: If not empty, overrides filename from URI.
                       .exe files don't get extracted

       extractto: Folder to extract an archive to
   -->

  <Target Name="libpcap-binariesTarget" BeforeTargets="CustomBuild" DependsOnTargets="7za">  
      <DownloadPackageTask 
           package="https://github.com/freeswitch/windows-deps/releases/download/libpcap-v$(libpcapVersion)_$(libpcapBuildNumber)/libpcap-$(libpcapVersion)_$(libpcapBuildNumber)-binaries-$(Platform.ToLower())-$(Configuration.ToLower()).zip"
           expectfileordirectory="$(libpcap_libDir)\binaries\$(Platform.ToLower())\$(Configuration.ToLower())\pcap_static.lib"
           outputfolder=""
           outputfilename="" 
           extractto="$(BaseDir)libs"
      />
  </Target> 

  <Target Name="libpcap-headersTarget" BeforeTargets="CustomBuild" DependsOnTargets="7za">  
      <DownloadPackageTask 
           package="https://github.com/freeswitch/windows-deps/releases/download/libpcap-v$(libpcapVersion)_$(libpcapBuildNumber)/libpcap-$(libpcapVersion)_$(libpcapBuildNumber)-headers.zip"
           expectfileordirectory="$(libpcap_libDir)\include\pcap.h" 
           outputfolder=""
           outputfilename="" 
           extractto="$(BaseDir)libs"
      />
  </Target> 

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(libpcap_libDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>SWITCH_HAVE_PCAP;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(libpcap_libDir)\binaries\$(Platform)\$(Configuration)\;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>pcap_static.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

</Project>
